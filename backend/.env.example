# ---- Server ----
PORT=5001
NODE_ENV=development

# ---- PostgreSQL (Homebrew default: your macOS username, no password) ----
PGHOST=localhost
PGPORT=5432
PGUSER=shlok
PGPASSWORD=
PGDATABASE=fleet_tracker

# ---- Security ----
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=8h

# ---- Python ML microservice ----
ML_SERVICE_URL=http://127.0.0.1:8000

# ---- Business config ----
DEFAULT_PRICE_PER_LITER=104.50

# ---- Notifications (optional) ----
# Until one of these is set, alerts are recorded in the notifications table
# with status 'skipped' and nothing is actually sent. The app works either way.
#
# Email — set ONE provider plus the from-address.
#   Resend:  https://resend.com   (3,000 emails/month free)
# RESEND_API_KEY=re_xxxxxxxx
#   Brevo:   https://brevo.com    (300 emails/day free)
# BREVO_API_KEY=xkeysib-xxxxxxxx
# NOTIFY_FROM_EMAIL=alerts@yourdomain.com
# NOTIFY_FROM_NAME=F.M. Amin & Co.
#
# SMS — Indian numbers require DLT registration with TRAI before any
# commercial SMS is delivered, whichever provider you use.
#   MSG91 (India, handles DLT):
# MSG91_AUTH_KEY=xxxxxxxx
# MSG91_TEMPLATE_ID=xxxxxxxx
#   Twilio:
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# NOTIFY_FROM_SMS=+1xxxxxxxxxx

# ---- Pump-local time (used by the odd-hours fraud rule) ----
PUMP_TIMEZONE=Asia/Kolkata
