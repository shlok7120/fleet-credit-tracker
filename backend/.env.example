# ---- Server ----
PORT=5001
NODE_ENV=development

# ---- PostgreSQL (Homebrew default: your macOS username, no password) ----
PGHOST=localhost
PGPORT=5432
PGUSER=shlok
PGPASSWORD=
PGDATABASE=fleet_tracker

# ---- Security ----
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=8h

# ---- Python ML microservice ----
ML_SERVICE_URL=http://127.0.0.1:8000

# ---- Business config ----
DEFAULT_PRICE_PER_LITER=104.50
